#
# Hitmap 1.2
# make.platforms.def: Specific compiler flags for Hitmap library and examples
#
# (c) 2011-2015, Arturo Gonzalez-Escribano
#

#
# 1. DEFAULT PLATFORM
#
PLATFORM=x86_64

#
# 2. GENERIC VALUES FOR COMMON FLAGS (TO BE OVERRIDDEN BY SPECIFIC PLATFORM DEFINITIONS BELLOW)
#
CC=cc
MPICC=mpicc
WARNINGS=
OPTIMIZATION=-O3
DEBUG_FLAGS=-g -O0
PROFILER_FLAGS=-pg
PLATFORM_FLAGS=
OPENMP_FLAGS=

#
# USE VARIABLE "PLATFORM_FLAGS" TO ADD NEW FLAGS/DEFINITIONS SPECIFIC FOR YOUR PLATFORM
#		e.g. PLATFORM_FLAGS=-flag -valuedFlag=value1  MYCOMPILER_DEFINITION=value2 
#


#
# 3. SPECIFIC PLATFORM DEFINITIONS
#

#
# COMPILING USING GCC-32bits
#
ifeq ($(PLATFORM),gcc32)
CC=gcc
OPTIMIZATION=-O3
OPENMP_FLAGS=-fopenmp
WARNINGS=-Wall -W -Wconversion -Wcast-qual -Wshadow -Wwrite-strings -Wpointer-arith
endif

#
# COMPILING USING GCC-64bits
#
ifeq ($(PLATFORM),gcc64)
CC=gcc
OPTIMIZATION=-O3
OPENMP_FLAGS=-fopenmp
WARNINGS=-Wall -W -Wconversion -Wcast-qual -Wshadow -Wwrite-strings -Wpointer-arith
PLATFORM_FLAGS=-mcmodel=medium
endif

#
# COMPILING USING DEFAULT COMPILER (GCC/LLVM STYLE) FOR x86_64
#
ifeq ($(PLATFORM),x86_64)
OPTIMIZATION=-O3
OPENMP_FLAGS=-fopenmp
WARNINGS=-Wall -W -Wconversion -Wcast-qual -Wshadow -Wwrite-strings -Wpointer-arith
PLATFORM_FLAGS=-mcmodel=medium
endif

#
# COMPILING USING Intel Compiler v12 (64 bits)
#
ifeq ($(PLATFORM),intel64)
CC=icc 
MPICC=icc -I/usr/include/mpich2
OPTIMIZATION=-O3
OPENMP_FLAGS=-openmp
PLATFORM_FLAGS=-mcmodel=medium
PROFILER_FLAGS=-p
endif


#
# COMPILING FOR bluegene (EPCC), 2007
#
ifeq ($(PLATFORM),bluegene)
CC=mpixlCC 
MPICC=mpixlCC 
OPTIMIZATION=-O4
endif


#
# COMPILING FOR hpcx (EPCC), 2007
#
ifeq ($(PLATFORM),hpcx)
CC=cc
MPICC=mpcc_r
OPTIMIZATION=-O4
PLATFORM_FLAGS=-q64 OBJECT_MODE=64
endif


#
# COMPILING FOR geopar Solaris (UVa), 2008-2010	
#
ifeq ($(PLATFORM),geopar-solaris)
OPTIMIZATION=-O5
endif



