#!/bin/bash
#
# Script for testing the correct results of parallel Hitmap and reference applications
#
# (c) 2015-2021 Arturo Gonzalez-Escribano
#

# 1. EXPERIMENT INFORMATION
# 1.1. APP NAME AND DEFAULT EXECUTABLES LIST
APP_NAME="Sparse matrices - Springs tension"
EXE_NAMES="spring_csr_sec spring_bitmap_sec spring_csr spring_csr_rows spring_bitmap spring_bitmap_iterskip spring_bitmap_iterdense"

# 1.2. APP/EXPERIMENT SPECIFIC PARAMETERS
ITERATIONS="10"
PROCS="1 2 3 5 7 9 10 13 25"
INPUTS_SOLUTIONS="../graphs/commanche_dual.rb,361566.93"
RESULT_FORMAT="Result norm:"

# 1.3. MPI RUN COMMAND
if [ -z "$MPI_RUN" ]
then
	MPI_RUN="mpirun "
fi


# 2. WRITE HEADER
echo
echo TESTING SCRIPT
echo --------------
echo "APPLICATION: $APP_NAME"

# 3. CHECK PARAMETERS
# 3.1. HELP
if [ $# -lt 1 ]
then
	echo
	echo -e "\tUsage: $0 all | <executable_names>"
	echo
	exit 1
fi

# 3.2. TEST SPECIFIC EXECUTABLES INSTEAD OF THE PREDEFINED LIST
if [ $1 != all ]
then
	EXE_NAMES=$@
fi
echo "EXECUTABLES: $EXE_NAMES"
echo

# 3.3. CHECK THAT EXECUTABLES HAVE BEEN GENERATED
for name in $EXE_NAMES
do
	OK=y
	if [ ! -x $name ]
	then
		echo "Error: Executable not found -- $name"
		OK=n
	fi
done
if [ $OK != y ]
then
	echo
	echo -e "\tBefore using this script generate the executables with:  $ make"
	echo
	exit 1
fi

# 4. TESTING EXPERIMENT
function doTest() {
	echo -e -n "Test $2 $3 $4:\t"

	# EXECUTE PROGRAM
	$MPI_RUN -n $2 ./$1 -n $3 $4 >check.output 2>check.err

	# EXECUTION ERRORS, SKIP TESTING RESULT FILE
	if [ 0 != $? ]
	then
			echo ERROR EXECUTING: $(cat check.err)
			continue
	fi

	# IF THE RESULTS FILE HAS NOT BEEN GENERATED
	OUTPUT=$(grep "$RESULT_FORMAT" check.output)
	if [ "$OUTPUT" = "" ]
	then
		echo "Error: The executable \"$exe\" does not provide the expected output format"
		echo "Output: "
		cat check.output
		echo
		exit -1
	# CHECK THE CONTENTS OF THE RESULTS LINE
	else
		CHECK=${OUTPUT#*: }
		if [ "$CHECK" != "$5" ]
		then
			echo ERROR: $CHECK, Expected: $5
		else
			echo OK
		fi
	fi
}

# 5. LOOPS FOR TESTS
for exe in $EXE_NAMES
do
	echo
	echo "Testing: $exe"
	echo "------------------------"
	for input_sol in $INPUTS_SOLUTIONS
	do
		input=${input_sol%,*}
		solution=${input_sol#*,}

		for iter in $ITERATIONS
		do
			for procs in $PROCS
			do
				doTest $exe $procs $iter $input $solution
			done
		done
	done
done

# 6. CLEAN
rm -f check.err check.output
